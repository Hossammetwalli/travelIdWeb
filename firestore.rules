rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone on the internet to view, edit, and delete
    // all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // your app will lose access to your Firestore database
    // 
    // This to all build during the development 
     match /{document=**} {
       allow read, write: if request.auth != null;
      
    }
    
    // This to allow users access only their data
    match /userData/{userId} /{document=**} {
    allow read, update, delete: if request.auth != null || request.auth.uid == userId;
    allow create: if request.auth != null 
     
      
    }
    
     // This to allow users access messages
    match /messages/{document=**} {
    allow read: if true
    allow write, update, delete: if request.auth != null && request.auth.uid == request.resource.data;
     // allow create: if request.auth != null 
     
      
    }
    
      // This to allow admin access property
    match /admins/{document=**} {
    allow read: if true
    allow write, update, delete: if request.auth != null && request.auth.uid == request.resource.data;
     // allow create: if request.auth != null 
     
      
    }
    
      match /properties/{document=**} {
      allow read: if true
      allow read, update, delete: if request.auth != null;
      //allow create: if request.auth != null 
     
      
    }
  }
}